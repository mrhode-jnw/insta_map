# Copy to .env and fill in.
APP_PASSWORD=bitte-aendern
# Long random string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# "default" = server-side fallback on refusals (Claude API only); empty = off
ANTHROPIC_FALLBACKS=default
# Optional: other data directory (default: ./data)
# SEHSCHULE_DATA_DIR=
